{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "2.78.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage",
    "notifications",
    "clipboardWrite",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://steamcommunity.com/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://*.epicgames.com/*",
    "https://www.gog.com/*",
    "https://gog.com/*",
    "https://luna.amazon.com/claims/*",
    "https://luna.amazon.fr/claims/*",
    "https://luna.amazon.de/claims/*",
    "https://luna.amazon.co.uk/claims/*",
    "https://luna.amazon.it/claims/*",
    "https://luna.amazon.es/claims/*",
    "https://luna.amazon.ca/claims/*",
    "https://luna.amazon.com.au/claims/*",
    "https://luna.amazon.co.jp/claims/*",
    "https://luna.amazon.in/claims/*",
    "https://luna.amazon.com.mx/claims/*",
    "https://luna.amazon.com.br/claims/*",
    "https://luna.amazon.nl/claims/*",
    "https://luna.amazon.se/claims/*",
    "https://luna.amazon.pl/claims/*",
    "https://luna.amazon.com.tr/claims/*",
    "https://gaming.amazon.com/*",
    "https://store-site-backend-static.ak.epicgames.com/*",
    "https://store-site-backend-static-ipv4.ak.epicgames.com/*",
    "https://www.gamerpower.com/*",
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.epicgames.com/*",
        "https://www.gog.com/*",
        "https://gog.com/*",
        "https://luna.amazon.com/claims/*",
        "https://luna.amazon.fr/claims/*",
        "https://luna.amazon.de/claims/*",
        "https://luna.amazon.co.uk/claims/*",
        "https://luna.amazon.it/claims/*",
        "https://luna.amazon.es/claims/*",
        "https://luna.amazon.ca/claims/*",
        "https://luna.amazon.com.au/claims/*",
        "https://luna.amazon.co.jp/claims/*",
        "https://luna.amazon.in/claims/*",
        "https://luna.amazon.com.mx/claims/*",
        "https://luna.amazon.com.br/claims/*",
        "https://luna.amazon.nl/claims/*",
        "https://luna.amazon.se/claims/*",
        "https://luna.amazon.pl/claims/*",
        "https://luna.amazon.com.tr/claims/*",
        "https://gaming.amazon.com/*"
      ],
      "js": [
        "content/gm-shim.js",
        "content/free-games-claimer.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.epicgames.com/*",
        "https://www.gog.com/*",
        "https://gog.com/*",
        "https://luna.amazon.com/claims/*",
        "https://luna.amazon.fr/claims/*",
        "https://luna.amazon.de/claims/*",
        "https://luna.amazon.co.uk/claims/*",
        "https://luna.amazon.it/claims/*",
        "https://luna.amazon.es/claims/*",
        "https://luna.amazon.ca/claims/*",
        "https://luna.amazon.com.au/claims/*",
        "https://luna.amazon.co.jp/claims/*",
        "https://luna.amazon.in/claims/*",
        "https://luna.amazon.com.mx/claims/*",
        "https://luna.amazon.com.br/claims/*",
        "https://luna.amazon.nl/claims/*",
        "https://luna.amazon.se/claims/*",
        "https://luna.amazon.pl/claims/*",
        "https://luna.amazon.com.tr/claims/*",
        "https://gaming.amazon.com/*",
        "https://store.steampowered.com/*"
      ],
      "js": [
        "content/launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "free-games-claimer@local",
      "strict_min_version": "128.0"
    }
  },
  "options_ui": {
    "page": "pages/popup.html?vue=onglet",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "__MSG_cmdOpenPopup__"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmdOpenDashboard__"
    },
    "check-now": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "__MSG_cmdCheckNow__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

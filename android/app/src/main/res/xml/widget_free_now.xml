<?xml version="1.0" encoding="utf-8"?>
<!-- Redessine par la veille, par l'appli, et (au plus) toutes les trente
     minutes (le minimum qu'Android accorde). Le compte a rebours, lui, defile seul. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_free_description"
    android:initialLayout="@layout/widget_free_now"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_free_now"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />

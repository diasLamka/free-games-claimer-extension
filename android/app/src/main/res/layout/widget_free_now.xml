<?xml version="1.0" encoding="utf-8"?>
<!-- « Gratuit maintenant » (1.16.0) sur l'ecran d'accueil. Des vues que
     RemoteViews accepte : un Chronometer y defile tout seul. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/free_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="19dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/free_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/section_free"
        android:textAllCaps="true"
        android:textColor="#FF000000"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/free_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/archivo_black"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="@string/widget_free_none_title"
            android:textAllCaps="true"
            android:textColor="#FF000000"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="2sp"
            android:textSize="20sp" />

        <Chronometer
            android:id="@+id/free_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:fontFamily="@font/space_mono_bold"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#FFE8FF00"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/free_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono_regular"
            android:maxLines="3"
            android:text="@string/widget_free_none"
            android:textColor="#FF000000"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/free_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:fontFamily="@font/space_mono_bold"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_free_claim"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

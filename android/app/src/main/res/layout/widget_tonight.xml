<?xml version="1.0" encoding="utf-8"?>
<!-- « Ce soir je joue a... » (1.8.0) sur l'ecran d'accueil. Des vues que
     RemoteViews accepte, et rien d'autre : le texte porte tout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="19dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/tonight_title"
        android:textAllCaps="true"
        android:textColor="#FF000000"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/archivo_black"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="@string/widget_empty_title"
        android:textAllCaps="true"
        android:textColor="#FF000000"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeStepGranularity="2sp"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_why"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono_regular"
            android:maxLines="2"
            android:text="@string/widget_empty"
            android:textColor="#FF000000"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_another"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:fontFamily="@font/space_mono_bold"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/tonight_another"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

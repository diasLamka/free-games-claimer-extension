<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- « Ta soiree choisit le jeu » (1.23.0) : OPTIONNELLE, demandee au toucher sur « Agenda ».
         Seuls les debuts et fins des evenements sont lus, jamais leurs titres ; rien n'est envoye. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- La mise a jour depuis l'appli (1.20.0) : passer l'APK telecharge au programme
         d'installation du systeme. L'utilisateur l'autorise une fois, dans les
         reglages Android (« Installer des applis inconnues »). Rien ne s'installe
         en arriere-plan. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Sans cette permission (1.26.0), Android 12 et plus demandent TOUJOURS confirmation, meme quand l'appli
         est l'installateur d'origine : c'est elle qui lui permet de mettre a jour sans geste. Normale,
         accordee a l'installation, aucune fenetre. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- WorkManager la declare pour ses taches de premier plan. L'appli n'en
         lance jamais (la recuperation de fond est une tache ordinaire) : la
         permission est retiree, pour ne rien demander qui ne serve pas. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- allowBackup a false : les sessions des magasins (cookies) ne partent
         jamais dans une sauvegarde du telephone. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.FreeGames">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Appui long sur l'icone : recuperer, ce soir, ajouter un souhait (1.12.0). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Le jeu que le PC n'a pas pu finir (1.4.0) : fgclaimer://finir?s=&i=&t=,
                 depuis l'alerte ntfy du PC ou la notification du relais. Le
                 lien designe un jeu, rien de plus : l'appli le cherche dans
                 ses offres et demande avant d'agir. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fgclaimer" android:host="finir" />
            </intent-filter>
            <!-- « Partager » depuis une autre appli : une fiche de jeu ou un titre. -->
            <intent-filter android:label="@string/share_target">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- L'image de l'annee (1.6.0), partagee depuis le cache de l'appli :
             un fichier, lu par l'appli choisie, et rien d'autre. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.partage"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/partage" />
        </provider>

        <!-- L'alarme de derniere chance (1.5.0) : posee par l'appli elle-meme,
             jamais appelee du dehors. -->
        <receiver
            android:name=".notify.LastChanceReceiver"
            android:exported="false" />

        <!-- « Plus tard » (1.12.0) : le bouton d'une notification et son alarme. -->
        <receiver
            android:name=".notify.SnoozeReceiver"
            android:exported="false" />

        <!-- « Ce soir je joue a... » (1.8.0) : le widget de l'ecran d'accueil. -->
        <receiver
            android:name=".widget.TonightWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tonight" />
        </receiver>

        <!-- « Gratuit maintenant » (1.16.0) : les jeux gratuits en cours, le premier a finir en grand. -->
        <receiver
            android:name=".widget.FreeNowWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_free_now" />
        </receiver>

        <!-- La reponse du systeme a l'installation de la mise a jour : demander un geste, reussir, echouer. -->
        <receiver android:name=".data.UpdateReceiver" android:exported="false" />

    </application>
</manifest>
